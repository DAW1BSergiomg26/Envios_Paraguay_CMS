# =============================================================================
# MonteAstur Envios — Producción
# =============================================================================
# Copiar este archivo como .env en el VPS:
#   cp .env.production.example /opt/monteastur/.env
# Editar TODOS los valores marcados como CHANGE_ME.
# NUNCA subir .env a Git.
# =============================================================================

# =============================================================================
# MonteAstur Envios — Producción
# =============================================================================
# Copiar este archivo como .env en el VPS:
#   cp .env.production.example /opt/monteastur/.env
# Editar TODOS los valores marcados como CHANGE_ME.
# NUNCA subir .env a Git.
# =============================================================================

# --- Spring / App ---
SPRING_PROFILES_ACTIVE=prod

# Solo usar 'update' en el primer arranque para crear el esquema.
# Luego cambiar a 'validate' para producción normal.
DB_DDL_AUTO=validate

# Desactivar datos demo en producción
APP_DEMO_DATA=false

ADMIN_USERNAME=CHANGE_ME_ADMIN
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Puerto servidor ---
PORT=8080

# --- MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=casarural
MYSQL_USER=casarural_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# Spring Boot datasource (no cambiar host/port a menos que se use BD externa)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/casarural?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&zeroDateTimeBehavior=convertToNull
DB_USERNAME=casarural_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Nginx ---
NGINX_PORT=80

# --- SSL ---
# Email para Let's Encrypt (obligatorio)
SSL_EMAIL=CHANGE_ME_EMAIL

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
UPTIME_KUMA_PORT=3001

# --- Timezone ---
TZ=America/Asuncion

# --- Rutas (no cambiar a menos que sea necesario) ---
UPLOAD_DIR=/app/uploads
LOG_DIR=/app/logs

# --- Backup ---
BACKUP_PATH=./backup
