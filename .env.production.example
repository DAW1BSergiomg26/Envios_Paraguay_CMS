# =============================================================================
# MonteAstur Envios — Producción
# =============================================================================
# Copiar este archivo como .env en el VPS:
#   cp .env.production.example /opt/monteastur/.env
# Editar TODOS los valores marcados como CHANGE_ME.
# NUNCA subir .env a Git.
# =============================================================================

# --- Spring / App ---
SPRING_PROFILES_ACTIVE=prod

# Primera vez usar update, luego validate:
#   update → crea/esquema automático (solo primera vez)
#   validate → valida que schema coincide con entities (producción normal)
DB_DDL_AUTO=validate

ADMIN_USERNAME=CHANGE_ME_ADMIN
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=casarural
MYSQL_USER=casarural_user
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Nginx ---
NGINX_PORT=80

# --- SSL ---
# Email para Let's Encrypt (obligatorio)
SSL_EMAIL=CHANGE_ME_EMAIL

# --- Monitoring ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
UPTIME_KUMA_PORT=3001

# --- Timezone ---
TZ=Europe/Madrid

# --- Rutas (no cambiar a menos que sea necesario) ---
UPLOAD_DIR=/app/uploads
LOG_DIR=/app/logs
