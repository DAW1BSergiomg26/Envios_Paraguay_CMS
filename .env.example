# =============================================
# MONTEASTUR ENVIOS — Configuración de Producción
# =============================================
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
# =============================================

# ---- Servidor ----
PORT=8080
NGINX_PORT=80

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=envios_paraguay_cms
MYSQL_USER=app_user
MYSQL_PASSWORD=changeme_app

# ---- Spring Boot (base de datos) ----
# Se usa internamente por docker-compose. No cambiar salvo que se use otro host/puerto.
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/envios_paraguay_cms?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&zeroDateTimeBehavior=convertToNull
DB_USERNAME=app_user
DB_PASSWORD=changeme_app

# ---- JPA / Hibernate ----
# En producción usar 'validate' o 'none'. Nunca 'update'.
DB_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ---- Thymeleaf ----
THYMELEAF_CACHE=true

# ---- Uploads (ruta dentro del contenedor) ----
UPLOAD_DIR=/app/uploads

# ---- Email (SMTP) ----
# Dejar vacío si no se usa email en producción
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@monteastur.com
SMTP_TO=admin@monteastur.com

# ---- Notificaciones automáticas (emails al cliente) ----
# APP_NOTIFICATION_MAIL_ENABLED=false apaga el envío sin redeploy
# APP_TRACKING_BASE_URL debe apuntar a la URL pública de seguimiento
APP_NOTIFICATION_MAIL_ENABLED=true
APP_NOTIFICATION_MAIL_FROM=no-reply@enviosparaguay.com.py
APP_TRACKING_BASE_URL=https://monteastur.com/tracking

# ---- Monitoring / Observability (Prometheus + Grafana) ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ---- Uptime Monitoring (Uptime Kuma) ----
UPTIME_KUMA_PORT=3001

# ---- Admin Panel (cambiar en producción) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_secure_password

# ---- SSL / Let's Encrypt ----
SSL_EMAIL=admin@monteastur.com

# ---- Backup ----
BACKUP_PATH=./backup

# ---- Timezone ----
TZ=America/Asuncion

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=prod

# ---- Logs ----
LOG_DIR=/app/logs

# ---- Redis / Session ----
REDIS_HOST=localhost
REDIS_PORT=6379
